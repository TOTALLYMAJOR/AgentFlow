{
  "name": "agentflow",
  "version": "0.3.0",
  "description": "Local-first control plane for dependency-aware Codex engineering builds",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "agentflow": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:server": "tsup apps/server/src/index.ts apps/server/src/cli.ts --format esm --platform node --target node22 --out-dir dist --clean --sourcemap",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:web && npm run build:server && npm run build:assets",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "pack:release": "node scripts/create-release.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/static": "10.1.2",
    "@phosphor-icons/react": "2.1.10",
    "@primer/react": "38.33.0",
    "better-sqlite3": "13.0.1",
    "commander": "15.0.0",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "swr": "2.4.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-is": "19.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.3",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.0"
  }
}
