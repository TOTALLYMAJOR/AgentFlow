{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "apps/server/src/**/*.ts",
    "apps/server/test/**/*.ts",
